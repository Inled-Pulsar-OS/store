"""
Pulsar Store CLI Helper — Universal Package & Ecosystem Manager.
Manage Flatpak applications, GNOME Shell extensions, Sayri AI skills & plugins from the terminal.
"""

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
import zipfile
from pathlib import Path

CATALOG_URLS = [
    "https://store-os.inled.es/schema/index.json",
    "https://raw.githubusercontent.com/Inled-Pulsar-OS/store/main/schema/index.json",
    "https://pulsar-store.pages.dev/schema/index.json",
]

CACHE_FILE = Path.home() / ".cache" / "pulsar-store" / "index.json"
GNOME_EXT_DIR = Path.home() / ".local" / "share" / "gnome-shell" / "extensions"

SAYRI_SKILL_PATHS = [
    Path.home() / ".local" / "share" / "sayri" / "skills",
    Path.home() / ".config" / "sayri" / "skills",
]

SAYRI_PLUGIN_PATHS = [
    Path.home() / ".local" / "share" / "sayri" / "plugins",
    Path.home() / ".config" / "sayri" / "plugins",
]

CLI_REMOTE_URL = "https://raw.githubusercontent.com/Inled-Pulsar-OS/store/main/cli/pulsar-store"


def get_catalog(force_refresh=False):
    """Fetches store catalog with local cache fallback."""
    local_db = Path(__file__).resolve().parent.parent / "schema" / "index.json"
    if local_db.is_file() and not force_refresh:
        try:
            return json.loads(local_db.read_text(encoding="utf-8"))
        except Exception:
            pass

    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    if not force_refresh and CACHE_FILE.is_file():
        try:
            if time.time() - CACHE_FILE.stat().st_mtime < 600:
                return json.loads(CACHE_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass

    for u in CATALOG_URLS:
        try:
            req = urllib.request.Request(u, headers={"User-Agent": "PulsarStoreCLI/1.0"})
            with urllib.request.urlopen(req, timeout=6) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                if data and "packages" in data and len(data["packages"]) > 0:
                    CACHE_FILE.write_text(json.dumps(data, indent=2), encoding="utf-8")
                    return data
        except Exception:
            continue

    if CACHE_FILE.is_file():
        try:
            return json.loads(CACHE_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass

    return {"packages": []}


def install_sayri_skill(pkg):
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)
    url = pkg.get("download_url")
    raw = pkg.get("raw_content") or pkg.get("skill_md")

    if not raw and not url:
        raise ValueError(f"No package content or download URL available for skill '{name}' ({pkg_id}).")

    for base_dir in SAYRI_SKILL_PATHS:
        target = base_dir / pkg_id
        target.mkdir(parents=True, exist_ok=True)

        if raw:
            (target / "SKILL.md").write_text(raw, encoding="utf-8")
        elif url:
            with tempfile.TemporaryDirectory() as tmp:
                tmp_p = Path(tmp) / "downloaded"
                req = urllib.request.Request(url, headers={"User-Agent": "PulsarStoreCLI/1.0"})
                with urllib.request.urlopen(req, timeout=15) as resp, open(tmp_p, "wb") as f:
                    shutil.copyfileobj(resp, f)
                if zipfile.is_zipfile(tmp_p):
                    with zipfile.ZipFile(tmp_p, "r") as z:
                        z.extractall(target)
                else:
                    shutil.copy2(tmp_p, target / "SKILL.md")

        meta = {
            "id": pkg_id,
            "name": name,
            "version": str(pkg.get("version", "1.0.0")),
            "type": "sayri_skill"
        }
        (target / "metadata.json").write_text(json.dumps(meta, indent=2), encoding="utf-8")

    print(f"✓ Sayri Skill '{name}' ({pkg_id}) installed successfully.")
    return True


def install_sayri_plugin(pkg):
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)
    url = pkg.get("download_url")

    if not url:
        raise ValueError(f"No download URL provided for plugin '{name}' ({pkg_id}).")

    with tempfile.TemporaryDirectory() as tmp:
        pkg_p = Path(tmp) / "plugin.zip"
        req = urllib.request.Request(url, headers={"User-Agent": "PulsarStoreCLI/1.0"})
        with urllib.request.urlopen(req, timeout=25) as resp, open(pkg_p, "wb") as f:
            shutil.copyfileobj(resp, f)

        if not zipfile.is_zipfile(pkg_p):
            raise ValueError(f"Downloaded file for '{pkg_id}' is not a valid ZIP archive.")

        for base_dir in SAYRI_PLUGIN_PATHS:
            target = base_dir / pkg_id
            target.mkdir(parents=True, exist_ok=True)
            with zipfile.ZipFile(pkg_p, "r") as z:
                z.extractall(target)

    print(f"✓ Sayri Plugin '{name}' ({pkg_id}) installed successfully.")
    return True


def install_gnome_extension(pkg):
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)
    uuid = pkg.get("metadata", {}).get("uuid") or pkg_id
    url = pkg.get("download_url")

    if not url:
        raise ValueError(f"No download URL provided for extension '{name}' ({uuid}).")

    target = GNOME_EXT_DIR / uuid
    target.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory() as tmp:
        zip_p = Path(tmp) / "ext.zip"
        req = urllib.request.Request(url, headers={"User-Agent": "PulsarStoreCLI/1.0"})
        with urllib.request.urlopen(req, timeout=20) as resp, open(zip_p, "wb") as f:
            shutil.copyfileobj(resp, f)
        if not zipfile.is_zipfile(zip_p):
            raise ValueError(f"Downloaded file for '{uuid}' is not a valid ZIP archive.")
        with zipfile.ZipFile(zip_p, "r") as z:
            z.extractall(target)

    proc = subprocess.run(["gnome-extensions", "enable", uuid], capture_output=True, text=True)
    if proc.returncode != 0 and proc.stderr:
        print(f"Note: gnome-extensions enable returned: {proc.stderr.strip()}")
    print(f"✓ GNOME Extension '{name}' ({uuid}) installed and enabled.")
    return True


def detect_os_base():
    """Detects the underlying OS base: 'arch', 'debian', or 'flatpak'/'generic'."""
    os_info = {}
    for p in ["/etc/os-release", "/usr/lib/os-release"]:
        if os.path.isfile(p):
            try:
                for line in Path(p).read_text(encoding="utf-8").splitlines():
                    if "=" in line:
                        k, v = line.split("=", 1)
                        os_info[k.strip().upper()] = v.strip().strip('"').lower()
                break
            except Exception:
                pass

    id_str = os_info.get("ID", "")
    id_like = os_info.get("ID_LIKE", "")
    full_ident = f"{id_str} {id_like}"

    if "arch" in full_ident or "manjaro" in full_ident or "endeavouros" in full_ident or shutil.which("pacman"):
        return "arch"
    elif "debian" in full_ident or "ubuntu" in full_ident or "pop" in full_ident or shutil.which("apt-get"):
        return "debian"
    elif shutil.which("flatpak"):
        return "flatpak"
    return "generic"


def install_app(pkg):
    """Installs a desktop application choosing the matching edition (Arch, Debian, or Flatpak) based on the host OS."""
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)
    formats = pkg.get("formats", {}) or {}

    flatpak_url = formats.get("flatpak") or pkg.get("metadata", {}).get("flatpakref_url")
    deb_url = formats.get("deb")
    arch_url = formats.get("arch") or formats.get("pacman")
    download_url = pkg.get("download_url", "")

    if not deb_url and download_url.endswith(".deb"):
        deb_url = download_url
    if not arch_url and (download_url.endswith(".pkg.tar.zst") or download_url.endswith(".pkg.tar.xz") or download_url.endswith(".pacman")):
        arch_url = download_url
    if not flatpak_url and (download_url.endswith(".flatpakref") or download_url.endswith(".flatpak") or "flathub.org" in download_url):
        flatpak_url = download_url

    os_base = detect_os_base()
    print(f"ℹ️  Detected OS environment base: {os_base.upper()}")

    # 1. Arch Linux base
    if os_base == "arch":
        if arch_url:
            print(f"📦 Installing Arch package (.pkg.tar.zst) for '{name}'...")
            with tempfile.TemporaryDirectory() as tmp:
                pkg_file = Path(tmp) / f"{pkg_id}.pkg.tar.zst"
                req = urllib.request.Request(arch_url, headers={"User-Agent": "PulsarStoreCLI/1.0"})
                with urllib.request.urlopen(req, timeout=30) as resp, open(pkg_file, "wb") as f:
                    shutil.copyfileobj(resp, f)
                proc = subprocess.run(["sudo", "pacman", "-U", "--noconfirm", str(pkg_file)], capture_output=True, text=True)
                if proc.returncode != 0:
                    err = proc.stderr.strip() or proc.stdout.strip() or f"pacman error {proc.returncode}"
                    raise RuntimeError(f"Arch pacman installation failed:\n{err}")
            print(f"✓ Arch package '{name}' ({pkg_id}) installed successfully.")
            return True
        elif flatpak_url and shutil.which("flatpak"):
            print(f"ℹ️  No native Arch package found, falling back to Flatpak for '{name}'...")
            return install_flatpak(pkg)
        else:
            available = []
            if deb_url: available.append("Debian (.deb)")
            if flatpak_url: available.append("Flatpak")
            raise RuntimeError(
                f"No compatible Arch Linux package (.pkg.tar.zst) available for '{name}' on this system.\n"
                f"Available formats: {', '.join(available) if available else 'None'}"
            )

    # 2. Debian / Ubuntu base
    elif os_base == "debian":
        if deb_url:
            print(f"📦 Installing Debian package (.deb) for '{name}'...")
            with tempfile.TemporaryDirectory() as tmp:
                deb_file = Path(tmp) / f"{pkg_id}.deb"
                req = urllib.request.Request(deb_url, headers={"User-Agent": "PulsarStoreCLI/1.0"})
                with urllib.request.urlopen(req, timeout=30) as resp, open(deb_file, "wb") as f:
                    shutil.copyfileobj(resp, f)
                proc = subprocess.run(["sudo", "apt-get", "install", "-y", str(deb_file)], capture_output=True, text=True)
                if proc.returncode != 0:
                    dpkg_proc = subprocess.run(["sudo", "dpkg", "-i", str(deb_file)], capture_output=True, text=True)
                    subprocess.run(["sudo", "apt-get", "install", "-f", "-y"], capture_output=True)
                    if dpkg_proc.returncode != 0:
                        err = proc.stderr.strip() or dpkg_proc.stderr.strip() or f"apt-get error {proc.returncode}"
                        raise RuntimeError(f"Debian .deb installation failed:\n{err}")
            print(f"✓ Debian package '{name}' ({pkg_id}) installed successfully.")
            return True
        elif flatpak_url and shutil.which("flatpak"):
            print(f"ℹ️  No native Debian package found, falling back to Flatpak for '{name}'...")
            return install_flatpak(pkg)
        else:
            available = []
            if arch_url: available.append("Arch Linux (.pkg.tar.zst)")
            if flatpak_url: available.append("Flatpak")
            raise RuntimeError(
                f"No compatible Debian package (.deb) available for '{name}' on this system.\n"
                f"Available formats: {', '.join(available) if available else 'None'}"
            )

    # 3. Flatpak / Other Linux
    else:
        if flatpak_url and shutil.which("flatpak"):
            return install_flatpak(pkg)
        raise RuntimeError(
            f"Unsupported OS base '{os_base}' and Flatpak is not available for '{name}'."
        )


def install_flatpak(pkg):
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)
    if not shutil.which("flatpak"):
        raise RuntimeError("Flatpak is not installed on this system. Please install 'flatpak' package manager.")

    # Ensure flathub remote is configured for user dependencies
    try:
        subprocess.run(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"], capture_output=True)
    except Exception:
        pass

    ref = pkg.get("formats", {}).get("flatpak") or pkg.get("metadata", {}).get("flatpakref_url") or pkg.get("download_url")
    if ref and ref.endswith(".zip"):
        raise RuntimeError(
            f"Format Mismatch for '{name}' ({pkg_id}):\n"
            f"The package is registered as Flatpak, but points to a ZIP file archive ({ref}).\n"
            f"Flatpak packages must be provided as .flatpak binary bundles, .flatpakref files, or Flathub application IDs."
        )

    tmp_bundle = None
    try:
        if ref and (ref.endswith(".flatpak") or ".flatpak" in ref):
            if ref.startswith("http://") or ref.startswith("https://"):
                tmp_bundle = os.path.join(tempfile.gettempdir(), f"{pkg_id}.flatpak")
                print(f"Downloading Flatpak bundle from {ref}...")
                urllib.request.urlretrieve(ref, tmp_bundle)
                bundle_path = tmp_bundle
            else:
                bundle_path = ref
            cmd = ["flatpak", "install", "--user", "-y", "--bundle", bundle_path]
        elif ref and (ref.startswith("http") or ref.endswith(".flatpakref")):
            cmd = ["flatpak", "install", "--user", "-y", "--from", ref]
        else:
            cmd = ["flatpak", "install", "--user", "-y", "flathub", pkg_id]

        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            err_msg = proc.stderr.strip() or proc.stdout.strip() or f"Exited with code {proc.returncode}"
            raise RuntimeError(f"Flatpak installation failed (command: {' '.join(cmd)}):\n{err_msg}")
        print(f"✓ Flatpak App '{name}' ({pkg_id}) installed successfully.")
        return True
    finally:
        if tmp_bundle and os.path.exists(tmp_bundle):
            try:
                os.remove(tmp_bundle)
            except Exception:
                pass


def install_system_package(pkg):
    pkg_id = pkg.get("id")
    if shutil.which("pacman"):
        proc = subprocess.run(["sudo", "pacman", "-S", "--noconfirm", pkg_id], capture_output=True, text=True)
    elif shutil.which("apt-get"):
        proc = subprocess.run(["sudo", "apt-get", "install", "-y", pkg_id], capture_output=True, text=True)
    else:
        raise RuntimeError("No supported package manager found (pacman or apt-get required).")

    if proc.returncode != 0:
        err_msg = proc.stderr.strip() or proc.stdout.strip() or f"Exited with code {proc.returncode}"
        raise RuntimeError(f"System package installation failed:\n{err_msg}")
    return True


def install_package_core(pkg):
    """Executes the appropriate installer backend and raises on failure."""
    pkg_type = pkg.get("type")
    if pkg_type in ("flatpak", "app", "desktop_app"):
        return install_app(pkg)
    elif pkg_type == "gnome_extension":
        return install_gnome_extension(pkg)
    elif pkg_type == "sayri_skill":
        return install_sayri_skill(pkg)
    elif pkg_type == "sayri_plugin":
        return install_sayri_plugin(pkg)
    elif pkg_type == "system":
        return install_system_package(pkg)
    else:
        raise ValueError(f"Unknown package type '{pkg_type}' for package '{pkg.get('id')}'.")


def run_text_install(pkg):
    pkg_type = pkg.get("type")
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)

    print(f"\n🚀 Installing: {name} ({pkg_id}) [{pkg_type}]")
    sec = pkg.get("security_report", {})
    if sec:
        print(f"🛡️  Security Audit: {sec.get('score', 95)}/100 ({sec.get('status', 'PASSED')})")
        if sec.get("summary"):
            print(f"ℹ️  {sec.get('summary')}\n")

    try:
        install_package_core(pkg)
        return True
    except Exception as exc:
        print(f"\n❌ Installation failed for '{name}' ({pkg_id}):\n{exc}\n", file=sys.stderr)
        return False


def run_gui_install(pkg):
    """Shows visual progress window with full error details and copy-to-clipboard functionality."""
    pkg_type = pkg.get("type")
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)

    try:
        import gi
        gi.require_version("Gtk", "4.0")
        from gi.repository import Gtk, GLib, Gdk
    except Exception:
        return run_text_install(pkg)

    import threading

    app = Gtk.Application(application_id=f"es.inled.pulsar.installer{int(time.time() * 1000) % 100000}")

    def on_activate(app):
        win = Gtk.Window(application=app)
        win.set_title(f"Pulsar Store — {name}")
        win.set_default_size(460, 240)
        win.set_resizable(True)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        main_box.set_margin_top(18)
        main_box.set_margin_bottom(18)
        main_box.set_margin_start(20)
        main_box.set_margin_end(20)

        # Header with title and badge
        header_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        title = Gtk.Label()
        title.set_markup(f"<span weight='bold' size='11500'>Installing {name}</span>")
        title.set_halign(Gtk.Align.START)
        header_box.append(title)

        meta_lbl = Gtk.Label()
        meta_lbl.set_markup(f"<span size='8500' foreground='#94a3b8'>{pkg_id} • {pkg_type}</span>")
        meta_lbl.set_halign(Gtk.Align.START)
        header_box.append(meta_lbl)
        main_box.append(header_box)

        # Progress bar
        pbar = Gtk.ProgressBar()
        pbar.set_fraction(0.2)
        main_box.append(pbar)

        # Status text
        status_lbl = Gtk.Label()
        status_lbl.set_markup("<span size='9000'>Connecting to Pulsar Store…</span>")
        status_lbl.set_halign(Gtk.Align.START)
        status_lbl.set_wrap(True)
        main_box.append(status_lbl)

        # Container for dynamic error widgets
        error_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        error_container.set_vexpand(True)
        main_box.append(error_container)

        # Action Buttons Box
        actions_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        actions_box.set_halign(Gtk.Align.END)
        actions_box.set_margin_top(6)

        btn_copy = Gtk.Button(label="📋 Copy Error")
        btn_copy.set_visible(False)
        actions_box.append(btn_copy)

        btn_close = Gtk.Button(label="Cancel")
        btn_close.connect("clicked", lambda _: win.close())
        actions_box.append(btn_close)

        main_box.append(actions_box)
        win.set_child(main_box)
        win.present()

        def _worker():
            try:
                GLib.idle_add(lambda: (
                    pbar.set_fraction(0.5),
                    status_lbl.set_markup("<span size='9000'>Downloading &amp; configuring package files…</span>")
                ))

                install_package_core(pkg)

                def _on_success():
                    pbar.set_fraction(1.0)
                    title.set_markup(f"<span weight='bold' size='11500' foreground='#22c55e'>✓ Installed {name}</span>")
                    status_lbl.set_markup("<span size='9000' foreground='#22c55e'>Ready to use in Pulsar OS.</span>")
                    btn_close.set_label("OK (closes in 4s)")
                    btn_close.add_css_class("suggested-action")
                    countdown = [4]
                    def _tick():
                        countdown[0] -= 1
                        if countdown[0] <= 0:
                            win.close()
                            return False
                        btn_close.set_label(f"OK (closes in {countdown[0]}s)")
                        return True
                    GLib.timeout_add_seconds(1, _tick)
                GLib.idle_add(_on_success)

            except Exception as exc:
                err_text = str(exc)
                full_error_log = (
                    f"Pulsar Store Installation Error\n"
                    f"Package: {name} ({pkg_id})\n"
                    f"Type: {pkg_type}\n"
                    f"Download URL: {pkg.get('download_url', 'N/A')}\n"
                    f"Time: {time.strftime('%Y-%m-%d %H:%M:%S')}\n\n"
                    f"Details:\n{err_text}"
                )

                def _on_err():
                    pbar.set_fraction(1.0)
                    title.set_markup("<span weight='bold' size='11500' foreground='#ef4444'>Installation Failed</span>")
                    status_lbl.set_markup("<span size='9000' foreground='#ef4444'>The installer encountered an error:</span>")

                    # Scrolled text view with error details
                    scrolled = Gtk.ScrolledWindow()
                    scrolled.set_min_content_height(100)
                    scrolled.set_max_content_height(180)
                    scrolled.set_vexpand(True)
                    scrolled.set_hexpand(True)

                    tv = Gtk.TextView()
                    tv.set_editable(False)
                    tv.set_cursor_visible(False)
                    tv.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
                    tv.set_monospace(True)
                    tv.get_buffer().set_text(err_text)
                    tv.set_margin_top(6)
                    tv.set_margin_bottom(6)
                    tv.set_margin_start(8)
                    tv.set_margin_end(8)
                    scrolled.set_child(tv)
                    error_container.append(scrolled)

                    # Configure Copy Error button
                    def _copy_error(_btn):
                        copied = False
                        try:
                            disp = Gdk.Display.get_default()
                            if disp:
                                disp.get_clipboard().set(full_error_log)
                                copied = True
                        except Exception:
                            pass
                        if not copied:
                            for tool in [["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]]:
                                try:
                                    subprocess.run(tool, input=full_error_log, text=True, check=True)
                                    copied = True
                                    break
                                except Exception:
                                    continue
                        btn_copy.set_label("✓ Copied!")
                        GLib.timeout_add_seconds(2, lambda: (btn_copy.set_label("📋 Copy Error"), False))

                    btn_copy.connect("clicked", _copy_error)
                    btn_copy.set_visible(True)
                    btn_close.set_label("Close")
                    win.set_default_size(520, 340)

                GLib.idle_add(_on_err)

        threading.Thread(target=_worker, daemon=True).start()

    app.connect("activate", on_activate)
    app.run(None)
    return True


def uninstall_package(pkg_id):
    """Uninstalls software across all supported ecosystems."""
    print(f"\n🗑️  Removing package: {pkg_id}...")
    removed = False

    # 1. Sayri Skills & Plugins
    for path_list in [SAYRI_SKILL_PATHS, SAYRI_PLUGIN_PATHS]:
        for base in path_list:
            target = base / pkg_id
            if target.is_dir():
                try:
                    shutil.rmtree(target)
                    print(f"✓ Removed from {target}")
                    removed = True
                except Exception as e:
                    print(f"✗ Error removing {target}: {e}")

    # 2. GNOME Extensions
    ext_target = GNOME_EXT_DIR / pkg_id
    if ext_target.is_dir():
        try:
            subprocess.run(["gnome-extensions", "disable", pkg_id], capture_output=True)
            shutil.rmtree(ext_target)
            print(f"✓ Removed GNOME Extension from {ext_target}")
            removed = True
        except Exception as e:
            print(f"✗ Error removing {ext_target}: {e}")

    # 3. Flatpak
    try:
        res = subprocess.run(["flatpak", "uninstall", "-y", pkg_id], capture_output=True, text=True)
        if res.returncode == 0:
            print(f"✓ Flatpak application '{pkg_id}' uninstalled.")
            removed = True
    except Exception:
        pass

    if not removed:
        print(f"ℹ️  Package '{pkg_id}' was not found among installed software.")
    return removed


def check_updates():
    catalog_data = get_catalog(force_refresh=True)
    packages = {p["id"]: p for p in catalog_data.get("packages", [])}
    updates = []

    # 1. GNOME Extensions
    if GNOME_EXT_DIR.is_dir():
        for sub in GNOME_EXT_DIR.iterdir():
            meta = sub / "metadata.json"
            if meta.is_file():
                try:
                    d = json.loads(meta.read_text(encoding="utf-8"))
                    uuid = d.get("uuid", sub.name)
                    cur_ver = str(d.get("version", "1"))
                    for p in packages.values():
                        if p.get("type") == "gnome_extension" and (p.get("metadata", {}).get("uuid") == uuid or p.get("id") == uuid):
                            if str(p.get("version")) != cur_ver:
                                updates.append(("GNOME Extension", p["name"], cur_ver, str(p["version"]), p))
                except Exception:
                    pass

    # 2. Sayri Skills
    for base in SAYRI_SKILL_PATHS:
        if base.is_dir():
            for sub in base.iterdir():
                pkg_id = sub.name
                if pkg_id in packages and packages[pkg_id].get("type") == "sayri_skill":
                    p = packages[pkg_id]
                    updates.append(("Sayri Skill", p["name"], "installed", str(p.get("version", "1.0")), p))

    # 3. Sayri Plugins
    for base in SAYRI_PLUGIN_PATHS:
        if base.is_dir():
            for sub in base.iterdir():
                pkg_id = sub.name
                if pkg_id in packages and packages[pkg_id].get("type") == "sayri_plugin":
                    p = packages[pkg_id]
                    updates.append(("Sayri Plugin", p["name"], "installed", str(p.get("version", "1.0")), p))

    # 4. Flatpaks
    try:
        res = subprocess.run(["flatpak", "remote-ls", "--updates"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            for line in res.stdout.strip().splitlines():
                parts = line.split("\t")
                updates.append(("Flatpak App", parts[0], "installed", "update available", None))
    except Exception:
        pass

    return updates


def self_update_cli():
    """Updates pulsar-store CLI itself from GitHub."""
    print("🔍 Checking for Pulsar Store CLI updates...")
    try:
        req = urllib.request.Request(CLI_REMOTE_URL, headers={"User-Agent": "PulsarStoreCLI/1.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            remote_code = resp.read()
            if not remote_code.startswith(b"#!/usr/bin/env python3"):
                print("✗ Invalid remote CLI script received.")
                return False
    except Exception as e:
        print(f"✗ Could not check for CLI updates: {e}")
        return False

    cur_file = Path(__file__).resolve()
    try:
        cur_code = cur_file.read_bytes()
    except Exception:
        cur_code = b""

    remote_hash = hashlib.sha256(remote_code).hexdigest()
    cur_hash = hashlib.sha256(cur_code).hexdigest() if cur_code else ""

    if remote_hash == cur_hash:
        print("✓ Pulsar Store CLI is up to date.")
        return True

    print("🚀 Newer version of Pulsar Store CLI detected! Updating...")
    targets = [
        Path("/usr/bin/pulsar-store"),
        Path("/usr/local/bin/pulsar-store"),
        Path.home() / ".local" / "bin" / "pulsar-store",
    ]
    if cur_file not in targets:
        targets.append(cur_file)

    for t in targets:
        try:
            t.parent.mkdir(parents=True, exist_ok=True)
            t.write_bytes(remote_code)
            t.chmod(0o755)
            print(f"✓ Updated: {t}")
        except Exception:
            pass

    print("✓ Pulsar Store CLI self-update complete!")
    return True


def main():
    parser = argparse.ArgumentParser(
        prog="pulsar-store",
        description="Pulsar Store CLI — Universal Package Manager for Pulsar OS"
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("check", help="Check for available updates across all software")
    sub.add_parser("update", help="Apply all pending software and CLI updates")
    sub.add_parser("self-update", help="Upgrade the pulsar-store CLI tool itself")
    sub.add_parser("list", help="List all available software in catalog")

    inst = sub.add_parser("install", help="Install a package by ID or URL")
    inst.add_argument("id", help="Package ID or pulsar:// URL")
    inst.add_argument("--cli", "--no-gui", action="store_true", help="Run installation in terminal mode without GUI dialog")
    inst.add_argument("--refresh", action="store_true", help="Force refresh catalog cache before installing")

    rem = sub.add_parser("remove", help="Uninstall a package by ID")
    rem.add_argument("id", help="Package ID to uninstall")

    uninst = sub.add_parser("uninstall", help="Alias for remove")
    uninst.add_argument("id", help="Package ID to uninstall")

    search_p = sub.add_parser("search", help="Search software catalog")
    search_p.add_argument("query", nargs="?", default="", help="Search query")

    info = sub.add_parser("info", help="Show package details and security report")
    info.add_argument("id", help="Package ID")

    hurl = sub.add_parser("handle-url", help="URL handler for pulsar://")
    hurl.add_argument("url", help="pulsar:// URL")

    args = parser.parse_args()

    if args.command == "self-update":
        self_update_cli()

    elif args.command in ("list", "search"):
        q = getattr(args, "query", "").lower() if args.command == "search" else ""
        catalog = get_catalog()
        pkgs = catalog.get("packages", [])
        if q:
            pkgs = [p for p in pkgs if q in p.get("name", "").lower() or q in p.get("description", "").lower() or q in p.get("id", "").lower()]

        print(f"\n📦 Pulsar Store Catalog ({len(pkgs)} packages):\n")
        print(f"{'ID':<34} | {'TYPE':<16} | {'VERSION':<10} | {'NAME'}")
        print("-" * 88)
        for p in pkgs:
            print(f"{p['id']:<34} | {p.get('type',''):<16} | v{p.get('version','1.0'):<9} | {p.get('name','')}")
        print("\n💡 Run 'pulsar-store info <id>' or 'pulsar-store install <id>' to inspect and install.")

    elif args.command == "check":
        print("🔍 Checking for updates across Pulsar OS ecosystems...")
        updates = check_updates()
        if not updates:
            print("✓ Everything is up to date!")
            return
        print(f"\n📦 {len(updates)} update(s) available:\n")
        print(f"{'TYPE':<20} | {'PACKAGE':<32} | {'CURRENT':<12} -> {'AVAILABLE':<12}")
        print("-" * 84)
        for t, n, c, d, _ in updates:
            print(f"{t:<20} | {n[:32]:<32} | {c:<12} -> {d:<12}")
        print("\n💡 Run 'pulsar-store update' to install all pending updates.")

    elif args.command == "update":
        self_update_cli()
        updates = check_updates()
        if not updates:
            print("✓ Everything is up to date.")
            return
        for _, _, _, _, p in updates:
            if p:
                run_text_install(p)
        subprocess.run(["flatpak", "update", "-y"])
        print("\n✓ All updates completed successfully!")

    elif args.command in ("remove", "uninstall"):
        pkg_id = args.id.strip()
        uninstall_package(pkg_id)

    elif args.command in ("install", "handle-url"):
        raw_id = getattr(args, "id", None) or getattr(args, "url", "")
        pkg_id = raw_id.replace("pulsar://install/", "").strip()
        force_refresh = getattr(args, "refresh", False)
        catalog = get_catalog(force_refresh=force_refresh)
        pkg = next((p for p in catalog.get("packages", []) if p["id"] == pkg_id or p.get("name", "").lower() == pkg_id.lower()), None)
        if not pkg and not force_refresh:
            catalog = get_catalog(force_refresh=True)
            pkg = next((p for p in catalog.get("packages", []) if p["id"] == pkg_id or p.get("name", "").lower() == pkg_id.lower()), None)

        if pkg:
            if getattr(args, "cli", False) or not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
                run_text_install(pkg)
            else:
                run_gui_install(pkg)
            return

        print(f"✗ Package '{pkg_id}' not found in Pulsar Store catalog.")

    elif args.command == "info":
        catalog = get_catalog()
        for p in catalog.get("packages", []):
            if p["id"] == args.id:
                print(f"\n📦 Package: {p['name']} ({p['id']})")
                print(f"📌 Version: v{p.get('version')} | Author: @{p.get('author')}")
                print(f"📝 {p.get('description')}")
                sec = p.get("security_report", {})
                if sec:
                    print(f"\n🛡️  Security Audit: {sec.get('score', 95)}/100 ({sec.get('status', 'PASSED')})")
                    print(f"   {sec.get('summary', '')}")
                return
        print(f"✗ Package '{args.id}' not found.")

    else:
        parser.print_help()


if __name__ == "__main__":
    main()
