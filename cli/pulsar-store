#!/usr/bin/env python3
"""Pulsar Store CLI Helper - Universal Package Manager for Pulsar OS."""

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
import zipfile
from pathlib import Path

CATALOG_URLS = [
    "https://store-os.inled.es/schema/index.json",
    "https://raw.githubusercontent.com/Inled-Pulsar-OS/store/main/schema/index.json",
    "https://pulsar-store.pages.dev/schema/index.json",
]
CACHE_FILE = Path.home() / ".cache" / "pulsar-store" / "index.json"
GNOME_EXT_DIR = Path.home() / ".local" / "share" / "gnome-shell" / "extensions"
SAYRI_SKILLS_DIR = Path.home() / ".config" / "sayri" / "skills"
SAYRI_PLUGINS_DIR = Path.home() / ".config" / "sayri" / "plugins"

def get_catalog(force_refresh=False):
    local_db = Path(__file__).resolve().parent.parent / "schema" / "index.json"
    if local_db.is_file():
        try:
            return json.loads(local_db.read_text(encoding="utf-8"))
        except Exception:
            pass
    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    if not force_refresh and CACHE_FILE.is_file():
        try:
            # Check cache age (max 10 minutes)
            if time.time() - CACHE_FILE.stat().st_mtime < 600:
                return json.loads(CACHE_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass
    for u in CATALOG_URLS:
        try:
            req = urllib.request.Request(u, headers={"User-Agent": "PulsarStoreCLI/1.0"})
            with urllib.request.urlopen(req, timeout=8) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                if data and "packages" in data and len(data["packages"]) > 0:
                    CACHE_FILE.write_text(json.dumps(data, indent=2), encoding="utf-8")
                    return data
        except Exception:
            continue
    if CACHE_FILE.is_file():
        try:
            return json.loads(CACHE_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass
    return {"packages": []}

def check_updates():
    catalog_data = get_catalog(force_refresh=True)
    packages = {p["id"]: p for p in catalog_data.get("packages", [])}
    updates = []

    # 1. GNOME Extensions
    if GNOME_EXT_DIR.is_dir():
        for sub in GNOME_EXT_DIR.iterdir():
            meta = sub / "metadata.json"
            if meta.is_file():
                try:
                    d = json.loads(meta.read_text(encoding="utf-8"))
                    uuid = d.get("uuid", sub.name)
                    cur_ver = str(d.get("version", "1"))
                    for p in packages.values():
                        if p.get("type") == "gnome_extension" and (p.get("metadata", {}).get("uuid") == uuid or p.get("id") == uuid):
                            if p.get("version") != cur_ver:
                                updates.append((" GNOME Extension", p["name"], cur_ver, p["version"], p))
                except Exception:
                    pass

    # 2. Sayri Skills
    if SAYRI_SKILLS_DIR.is_dir():
        for sub in SAYRI_SKILLS_DIR.iterdir():
            pkg_id = sub.name
            if pkg_id in packages and packages[pkg_id].get("type") == "sayri_skill":
                p = packages[pkg_id]
                updates.append((" Sayri Skill", p["name"], "installed", p["version"], p))

    # 3. Sayri Plugins
    if SAYRI_PLUGINS_DIR.is_dir():
        for sub in SAYRI_PLUGINS_DIR.iterdir():
            pkg_id = sub.name
            if pkg_id in packages and packages[pkg_id].get("type") == "sayri_plugin":
                p = packages[pkg_id]
                updates.append((" Sayri Plugin", p["name"], "installed", p["version"], p))

    # 4. Flatpaks
    try:
        res = subprocess.run(["flatpak", "remote-ls", "--updates"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            for line in res.stdout.strip().splitlines():
                parts = line.split("\t")
                updates.append((" Flatpak App", parts[0], "installed", "new update", None))
    except Exception:
        pass

    return updates

def run_text_install(pkg):
    pkg_type = pkg.get("type")
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)
    url = pkg.get("download_url")

    print(f"\nInstalling: {name} ({pkg_id}) [Type: {pkg_type}]")
    sec = pkg.get("security_report", {})
    if sec:
        print(f"OpenCode Report: {sec.get('score', 95)}/100 ({sec.get('status', 'PASSED')})")
        print(f"Summary: {sec.get('summary', '')}\n")

    if pkg_type == "flatpak":
        ref = pkg.get("metadata", {}).get("flatpakref_url") or url or pkg_id
        return subprocess.run(["flatpak", "install", "-y", ref]).returncode == 0

    elif pkg_type == "gnome_extension":
        uuid = pkg.get("metadata", {}).get("uuid") or pkg_id
        target = GNOME_EXT_DIR / uuid
        with tempfile.TemporaryDirectory() as tmp:
            zip_p = Path(tmp) / "ext.zip"
            urllib.request.urlretrieve(url, zip_p)
            target.mkdir(parents=True, exist_ok=True)
            with zipfile.ZipFile(zip_p, "r") as z:
                z.extractall(target)
            subprocess.run(["gnome-extensions", "enable", uuid], capture_output=True)
            print(f"Extension '{name}' ({uuid}) installed and enabled.")
            return True

    elif pkg_type in ("sayri_skill", "sayri_plugin"):
        is_plugin = ("gateway" in pkg_id or "plugin" in pkg_id or pkg_type == "sayri_plugin")
        dest_root = SAYRI_PLUGINS_DIR if is_plugin else SAYRI_SKILLS_DIR
        target = dest_root / pkg_id
        with tempfile.TemporaryDirectory() as tmp:
            pkg_p = Path(tmp) / "pkg.zip"
            urllib.request.urlretrieve(url, pkg_p)
            target.mkdir(parents=True, exist_ok=True)
            with zipfile.ZipFile(pkg_p, "r") as z:
                z.extractall(target)
            if is_plugin:
                alt_target = SAYRI_SKILLS_DIR / pkg_id
                alt_target.mkdir(parents=True, exist_ok=True)
                with zipfile.ZipFile(pkg_p, "r") as z:
                    z.extractall(alt_target)
            print(f"{'Plugin' if is_plugin else 'Skill'} '{name}' installed into {target}.")
            return True

    return False

def run_gui_install(pkg):
    """Downloads and installs the package while showing a real-time GTK progress window."""
    pkg_type = pkg.get("type")
    pkg_id = pkg.get("id")
    name = pkg.get("name", pkg_id)
    url = pkg.get("download_url")

    try:
        import gi
        gi.require_version("Gtk", "4.0")
        from gi.repository import Gtk, GLib
    except Exception:
        return run_text_install(pkg)

    import threading

    app = Gtk.Application(application_id=f"es.inled.pulsar.store.installer{int(time.time())}")

    def on_activate(app):
        win = Gtk.Window(application=app)
        win.set_title(f"Pulsar Store — {name}")
        win.set_default_size(380, 180)
        win.set_resizable(False)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        box.set_margin_start(18)
        box.set_margin_end(18)

        # Title
        title = Gtk.Label()
        title.set_markup(f"<span weight='bold' size='11500'>Installing {name}</span>")
        title.set_halign(Gtk.Align.START)
        box.append(title)

        # ID / Type
        meta_lbl = Gtk.Label()
        meta_lbl.set_markup(f"<span size='8500' foreground='#94a3b8'>{pkg_id} • {pkg_type}</span>")
        meta_lbl.set_halign(Gtk.Align.START)
        box.append(meta_lbl)

        # Progress bar
        pbar = Gtk.ProgressBar()
        pbar.set_fraction(0.15)
        pbar.set_margin_top(4)
        pbar.set_margin_bottom(4)
        box.append(pbar)

        # Status text
        status_lbl = Gtk.Label()
        status_lbl.set_markup("<span size='9000'>Connecting to Pulsar Store…</span>")
        status_lbl.set_halign(Gtk.Align.START)
        box.append(status_lbl)

        # Close / Cancel button
        btn_close = Gtk.Button(label="Cancel")
        btn_close.connect("clicked", lambda _: win.close())
        btn_close.set_halign(Gtk.Align.END)
        box.append(btn_close)

        win.set_child(box)
        win.present()

        def _worker():
            try:
                GLib.idle_add(lambda: (
                    pbar.set_fraction(0.35),
                    status_lbl.set_markup("<span size='9000'>Downloading package archive…</span>")
                ))

                if pkg_type == "flatpak":
                    ref = pkg.get("metadata", {}).get("flatpakref_url") or url or pkg_id
                    res = subprocess.run(["flatpak", "install", "-y", ref], capture_output=True)
                    ok = (res.returncode == 0)

                elif pkg_type == "gnome_extension":
                    uuid = pkg.get("metadata", {}).get("uuid") or pkg_id
                    target = GNOME_EXT_DIR / uuid
                    with tempfile.TemporaryDirectory() as tmp:
                        zip_p = Path(tmp) / "ext.zip"
                        urllib.request.urlretrieve(url, zip_p)
                        GLib.idle_add(lambda: (pbar.set_fraction(0.75), status_lbl.set_markup("<span size='9000'>Extracting GNOME extension…</span>")))
                        target.mkdir(parents=True, exist_ok=True)
                        with zipfile.ZipFile(zip_p, "r") as z:
                            z.extractall(target)
                        subprocess.run(["gnome-extensions", "enable", uuid], capture_output=True)
                    ok = True

                elif pkg_type in ("sayri_skill", "sayri_plugin"):
                    is_plugin = ("gateway" in pkg_id or "plugin" in pkg_id or pkg_type == "sayri_plugin")
                    dest_root = SAYRI_PLUGINS_DIR if is_plugin else SAYRI_SKILLS_DIR
                    target = dest_root / pkg_id
                    with tempfile.TemporaryDirectory() as tmp:
                        pkg_p = Path(tmp) / "pkg.zip"
                        urllib.request.urlretrieve(url, pkg_p)
                        GLib.idle_add(lambda: (pbar.set_fraction(0.75), status_lbl.set_markup("<span size='9000'>Configuring isolated sandbox…</span>")))
                        target.mkdir(parents=True, exist_ok=True)
                        with zipfile.ZipFile(pkg_p, "r") as z:
                            z.extractall(target)
                        if is_plugin:
                            alt_target = SAYRI_SKILLS_DIR / pkg_id
                            alt_target.mkdir(parents=True, exist_ok=True)
                            with zipfile.ZipFile(pkg_p, "r") as z:
                                z.extractall(alt_target)
                    ok = True
                else:
                    ok = False

                if ok:
                    def _on_success():
                        pbar.set_fraction(1.0)
                        title.set_markup(f"<span weight='bold' size='11500' foreground='#22c55e'>Installed: {name}</span>")
                        status_lbl.set_markup("<span size='9000' foreground='#22c55e'>Ready to use in Pulsar OS.</span>")
                        btn_close.set_label("OK (closes in 5s)")
                        btn_close.add_css_class("suggested-action")
                        countdown = [5]
                        def _tick():
                            countdown[0] -= 1
                            if countdown[0] <= 0:
                                win.close()
                                return False
                            btn_close.set_label(f"OK (closes in {countdown[0]}s)")
                            return True
                        GLib.timeout_add_seconds(1, _tick)
                    GLib.idle_add(_on_success)
                else:
                    def _on_fail():
                        pbar.set_fraction(1.0)
                        title.set_markup(f"<span weight='bold' size='11500' foreground='#ef4444'>Installation Failed</span>")
                        status_lbl.set_markup("<span size='9000' foreground='#ef4444'>An error occurred during package installation.</span>")
                        btn_close.set_label("Close")
                    GLib.idle_add(_on_fail)

            except Exception as exc:
                def _on_err():
                    title.set_markup(f"<span weight='bold' size='11500' foreground='#ef4444'>Error</span>")
                    status_lbl.set_markup(f"<span size='8500' foreground='#ef4444'>{exc}</span>")
                    btn_close.set_label("Close")
                GLib.idle_add(_on_err)

        threading.Thread(target=_worker, daemon=True).start()

    app.connect("activate", on_activate)
    app.run(None)
    return True

def install_package(pkg):
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
        return run_gui_install(pkg)
    return run_text_install(pkg)

def uninstall_package(pkg_id):
    """Uninstalls a package by ID across Flatpaks, GNOME Extensions, and Sayri Skills/Plugins."""
    print(f"\n Removing package: {pkg_id}...")
    removed = False

    # 1. Check Sayri Skills & Plugins
    for base in [SAYRI_SKILLS_DIR, SAYRI_PLUGINS_DIR]:
        target = base / pkg_id
        if target.is_dir():
            try:
                shutil.rmtree(target)
                print(f" Removed Sayri package from {target}")
                removed = True
            except Exception as e:
                print(f" Error deleting {target}: {e}")

    # 2. Check GNOME Extensions
    ext_target = GNOME_EXT_DIR / pkg_id
    if ext_target.is_dir():
        try:
            subprocess.run(["gnome-extensions", "disable", pkg_id], capture_output=True)
            shutil.rmtree(ext_target)
            print(f" Removed GNOME Extension from {ext_target}")
            removed = True
        except Exception as e:
            print(f" Error deleting {ext_target}: {e}")

    # 3. Check Flatpak
    try:
        res = subprocess.run(["flatpak", "uninstall", "-y", pkg_id], capture_output=True, text=True)
        if res.returncode == 0:
            print(f" Flatpak application '{pkg_id}' uninstalled.")
            removed = True
    except Exception:
        pass

    if not removed:
        print(f" Package '{pkg_id}' was not found among installed software.")
    return removed

CLI_REMOTE_URL = "https://raw.githubusercontent.com/Inled-Pulsar-OS/store/main/cli/pulsar-store"

def self_update_cli():
    """Checks and updates the pulsar-store CLI itself to the latest version from upstream repository."""
    print(" Checking for Pulsar Store CLI updates...")
    try:
        req = urllib.request.Request(CLI_REMOTE_URL, headers={"User-Agent": "PulsarStoreCLI/1.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            remote_code = resp.read()
            if not remote_code.startswith(b"#!/usr/bin/env python3"):
                print(" Invalid remote CLI script received.")
                return False
    except Exception as e:
        print(f" Could not check for CLI updates: {e}")
        return False

    cur_file = Path(__file__).resolve()
    try:
        cur_code = cur_file.read_bytes()
    except Exception:
        cur_code = b""

    # Compare SHA256 hashes
    remote_hash = hashlib.sha256(remote_code).hexdigest()
    cur_hash = hashlib.sha256(cur_code).hexdigest() if cur_code else ""

    if remote_hash == cur_hash:
        print(" Pulsar Store CLI is already on the latest version.")
        return True

    print(" Newer version of Pulsar Store CLI detected! Updating...")
    targets = [
        Path("/usr/bin/pulsar-store"),
        Path.home() / ".local" / "bin" / "pulsar-store",
    ]
    if cur_file not in targets:
        targets.append(cur_file)

    updated_any = False
    for t in targets:
        try:
            t.parent.mkdir(parents=True, exist_ok=True)
            t.write_bytes(remote_code)
            t.chmod(0o755)
            print(f" Updated: {t}")
            updated_any = True
        except PermissionError:
            try:
                with tempfile.NamedTemporaryFile(delete=False) as tmp_f:
                    tmp_f.write(remote_code)
                    tmp_name = tmp_f.name
                subprocess.run(["pkexec", "cp", tmp_name, str(t)], check=True)
                subprocess.run(["pkexec", "chmod", "+x", str(t)], check=True)
                os.unlink(tmp_name)
                print(f" Updated (root): {t}")
                updated_any = True
            except Exception as exc:
                print(f" Could not update {t}: {exc}")
        except Exception as e:
            print(f" Could not update {t}: {e}")

    if updated_any:
        print(" Pulsar Store CLI self-update complete!")
        return True
    return False

def main():
    parser = argparse.ArgumentParser(prog="pulsar-store", description="Pulsar Store CLI Helper")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("check", help="Check for available updates across all ecosystems")
    sub.add_parser("update", help="Apply all pending updates (including CLI self-update)")
    sub.add_parser("self-update", help="Update the pulsar-store CLI to the latest version")
    
    inst = sub.add_parser("install", help="Install a package by ID or URL")
    inst.add_argument("id", help="Package ID or URL (e.g. pulsar://install/<id>)")

    rem = sub.add_parser("remove", help="Uninstall/remove an installed package")
    rem.add_argument("id", help="Package ID to uninstall")

    uninst = sub.add_parser("uninstall", help="Alias for remove")
    uninst.add_argument("id", help="Package ID to uninstall")

    search_p = sub.add_parser("search", help="Search software packages in catalog")
    search_p.add_argument("query", nargs="?", default="", help="Keyword to search for")

    list_p = sub.add_parser("list", help="List all software packages in catalog")

    info = sub.add_parser("info", help="Show package details and security audit")
    info.add_argument("id", help="Package ID")

    hurl = sub.add_parser("handle-url", help="MIME scheme handler for pulsar:// URLs")
    hurl.add_argument("url", help="URL pulsar://install/<id>")

    args = parser.parse_args()

    if args.command == "self-update":
        self_update_cli()
        return

    elif args.command in ("list", "search"):
        q = getattr(args, "query", "").lower() if args.command == "search" else ""
        catalog = get_catalog()
        pkgs = catalog.get("packages", [])
        if q:
            pkgs = [p for p in pkgs if q in p["name"].lower() or q in p["description"].lower() or q in p["id"].lower()]
        
        print(f"\n Pulsar Store Catalog ({len(pkgs)} packages found):\n")
        print(f"{'ID':<34} | {'TYPE':<16} | {'VERSION':<10} | {'NAME'}")
        print("-" * 88)
        for p in pkgs:
            print(f"{p['id']:<34} | {p.get('type',''):<16} | v{p.get('version','1.0'):<9} | {p.get('name','')}")
        print("\n Run 'pulsar-store info <id>' or 'pulsar-store install <id>' to inspect and install.")

    elif args.command == "check":
        print("🔍 Checking for updates across Pulsar OS ecosystems...")
        updates = check_updates()
        if not updates:
            print(" Everything is up to date!")
            return
        print(f"\n {len(updates)} update(s) available:\n")
        print(f"{'TYPE':<20} | {'PACKAGE':<32} | {'CURRENT':<12} -> {'AVAILABLE':<12}")
        print("-" * 84)
        for t, n, c, d, _ in updates:
            print(f"{t:<20} | {n[:32]:<32} | {c:<12} -> {d:<12}")
        print("\n Run 'pulsar-store update' to install all updates.")

    elif args.command == "update":
        self_update_cli()
        updates = check_updates()
        if not updates:
            print(" Everything is up to date.")
            return
        for _, n, _, _, p in updates:
            if p: install_package(p)
        subprocess.run(["flatpak", "update", "-y"])
        print("\n All updates completed successfully!")

    elif args.command in ("remove", "uninstall"):
        pkg_id = args.id.strip()
        uninstall_package(pkg_id)

    elif args.command == "install":
        pkg_id = args.id.replace("pulsar://install/", "").strip()
        catalog = get_catalog()
        pkg = next((p for p in catalog.get("packages", []) if p["id"] == pkg_id or p.get("name", "").lower() == pkg_id.lower()), None)
        if not pkg:
            catalog = get_catalog(force_refresh=True)
            pkg = next((p for p in catalog.get("packages", []) if p["id"] == pkg_id or p.get("name", "").lower() == pkg_id.lower()), None)
        if pkg:
            install_package(pkg)
            return
        print(f" Package '{pkg_id}' not found in catalog.")

    elif args.command == "handle-url":
        pkg_id = args.url.replace("pulsar://install/", "").strip()
        catalog = get_catalog()
        pkg = next((p for p in catalog.get("packages", []) if p["id"] == pkg_id or p.get("name", "").lower() == pkg_id.lower()), None)
        if not pkg:
            catalog = get_catalog(force_refresh=True)
            pkg = next((p for p in catalog.get("packages", []) if p["id"] == pkg_id or p.get("name", "").lower() == pkg_id.lower()), None)
        if pkg:
            install_package(pkg)
            return
        print(f" Package '{pkg_id}' not found in catalog.")

    elif args.command == "info":
        catalog = get_catalog()
        for p in catalog.get("packages", []):
            if p["id"] == args.id:
                print(f"\n Package: {p['name']} ({p['id']})")
                print(f"📌 Version: v{p.get('version')} | Author: @{p.get('author')}")
                print(f"📝 {p.get('description')}")
                sec = p.get("security_report", {})
                print(f"\n OpenCode Report: {sec.get('score', 95)}/100 ({sec.get('status', 'PASSED')})")
                print(f" {sec.get('summary', '')}")
                return
        print(f" Package '{args.id}' not found.")
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
